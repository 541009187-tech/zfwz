{
  "name": "payment-app",
  "version": "1.0.0",
  "description": "支付系统 - 支持支付宝/微信支付接入和本地测试网关模式",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:local": "node scripts/dev-local.js",
    "dev:server": "nest start --watch",
    "dev:client": "vite --host 0.0.0.0 --port 8080",
    "build": "bash scripts/build.sh",
    "build:server": "nest build",
    "build:client": "vite build",
    "start": "node dist/server/main.js",
    "start:prod": "bash dist/run.sh",
    "lint": "node scripts/lint.js",
    "precommit": "node scripts/hooks/run-precommit.js",
    "eslint": "eslint . --cache",
    "type:check": "tsc --noEmit -p tsconfig.app.json",
    "type:check:client": "tsc --noEmit -p client/tsconfig.json || true",
    "type:check:server": "tsc --noEmit -p tsconfig.app.json",
    "stylelint": "stylelint \"**/*.css\" --cache",
    "gen:openapi": "echo \"openapi generation skipped\"",
    "prepare": "if [ -d .git ]; then git config core.hooksPath .githooks; fi"
  },
  "dependencies": {
    "@lark-apaas/client-toolkit": "^1.0.0",
    "@lark-apaas/fullstack-nestjs-core": "^1.0.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/axios": "^3.0.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "drizzle-orm": "^0.30.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.22.0",
    "lucide-react": "^0.400.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.3.0",
    "sonner": "^1.5.0",
    "qrcode.react": "^3.1.0",
    "dayjs": "^1.11.0",
    "lodash-es": "^4.17.21",
    "nunjucks": "^3.2.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.23.0",
    "alipay-sdk": "^3.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/nunjucks": "^3.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^6.0.0",
    "typescript": "^5.5.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.0",
    "tw-animate-css": "^1.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "prettier": "^3.2.0",
    "stylelint": "^16.0.0"
  }
}
